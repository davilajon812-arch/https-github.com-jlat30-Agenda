# Valores que la app móvil necesita al compilar.
# Se pasan con --dart-define-from-file=.env (ver README de mobile).
#
# dev:
SUPABASE_URL=https://tu-proyecto-dev.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# En el emulador de Android el host local es 10.0.2.2 (no 127.0.0.1).
API_BASE_URL=http://10.0.2.2:8000
APP_FLAVOR=dev

# prod (crea un .env.prod aparte):
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_yyy
# API_BASE_URL=https://agendapro-api.onrender.com
# APP_FLAVOR=prod
