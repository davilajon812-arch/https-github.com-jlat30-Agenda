# --- Aplicación ---
APP_NAME=Citurno API
APP_ENV=dev
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Supabase ---
# Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# Solo para proyectos con llaves simétricas (HS256). Déjalo vacío si usas JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Base de datos (pooler de Supabase, modo sesión) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8

# --- Google Play Billing ---
# "fake" simula Play (desarrollo local) | "play" usa la API real.
BILLING_PROVIDER=fake
GOOGLE_PLAY_PACKAGE_NAME=com.jlaburto.citurno
# JSON completo de la cuenta de servicio en una sola línea (solo en Render).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Secreto compartido con la suscripción push de Pub/Sub.
GOOGLE_PUBSUB_RTDN_TOKEN=
# Secreto del endpoint interno de mantenimiento.
MAINTENANCE_TOKEN=
